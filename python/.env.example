# Common Crawl Pipeline - Environment Variables
# Copy this file to .env and adjust values as needed

# RabbitMQ Configuration
RABBITMQ_CONNECTION_STRING=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE_NAME=batches

# Prometheus Metrics Ports
BATCHER_METRICS_PORT=9000
WORKER_METRICS_PORT=9001

# Common Crawl Configuration
CC_BASE_URL=https://data.commoncrawl.org
CC_CRAWL_PATH=cc-index/collections/CC-MAIN-2024-30/indexes

# Processing Configuration
BATCH_SIZE=50
WORKER_PREFETCH_COUNT=1

# Optional: Logging Configuration
LOG_LEVEL=INFO

# Object Store Configuration (MinIO)
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=commoncrawl-documents
MINIO_SECURE=false
MINIO_BUFFER_SIZE_MB=5

# Retry Configuration
DOWNLOAD_MAX_RETRIES=3
DOWNLOAD_RETRY_DELAY=1.0
DOWNLOAD_TIMEOUT=30
RABBITMQ_MAX_RETRIES=5
RABBITMQ_RETRY_DELAY=2.0
